# =======================================================
# ClinicCare AI - Environment Configuration Example
# =======================================================

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__ClinicManagementDb=Server=(localdb)\mssqllocaldb;Database=ClinicManagementDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# JWT Configuration
Jwt__Key=ClinicCareSuperSecretKey2026MustBeAtLeast32BytesLong!
Jwt__Issuer=ClinicCareServer
Jwt__Audience=ClinicCareClient
Jwt__ExpiryMinutes=1440

# Gemini AI Provider Configuration (Optional for demo, fallback mode available)
AiProvider__IsEnabled=false
AiProvider__ApiKey=YOUR_GEMINI_API_KEY_HERE
AiProvider__ModelName=gemini-1.5-flash
AiProvider__ProviderUrl=https://generativelanguage.googleapis.com
AiProvider__TimeoutSeconds=10

# Development Demo Data Seeder
DemoSeed__Enabled=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5258
