{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AiRateLimiting": {
    "WindowSeconds": 60,
    "ChatPermitLimit": 8,
    "EndpointPermitLimit": 10,
    "TestingPermitLimit": 1000
